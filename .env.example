# DeepSeek API (OpenAI-compatible). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Optional overrides (defaults match DeepSeek Flash)
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=   # if set, used instead of DEEPSEEK_API_KEY

# Discord bot (Developer Portal → Bot → Token)
# Invite the bot with Send Messages (+ Embed Links if you want).
DISCORD_BOT_TOKEN=

# Where to post: channel name (without #) and/or snowflake id
DISCORD_CHANNEL=paper-botten
# DISCORD_CHANNEL_ID=123456789012345678
