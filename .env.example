# DeepSeek API (OpenAI-compatible). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Optional overrides (defaults match DeepSeek Flash)
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=   # if set, used instead of DEEPSEEK_API_KEY

# Discord bot (Developer Portal → Bot → Token)
# Invite the bot to your server with Send Messages + Embed Links.
STJERNEBOTTENS_DISCORD_TOKEN=
# DISCORD_BOT_TOKEN=   # alternate name also accepted
# Channel name (default: paper-botten) or set an id to avoid ambiguity
# DISCORD_CHANNEL=paper-botten
# DISCORD_CHANNEL_ID=
